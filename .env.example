# Get a free API key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Model to use. qwen/qwen3.8-27b scored 95% on our eval and is the default.
# Alternatives: openai/gpt-oss-120b (more capable but slower), openai/gpt-oss-20b
GROQ_MODEL=qwen/qwen3.8-27b

# Path to the DuckDB database (relative to project root)
DB_PATH=data/chinook.duckdb

# Max number of tables the schema retriever returns per query
TOP_K_TABLES=5
