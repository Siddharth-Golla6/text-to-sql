# Get a free API key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Model to use. llama-3.3-70b-versatile is the default; recommended for SQL quality.
# Alternatives: llama-3.1-70b-versatile, llama-3.1-8b-instant (faster, lower quality)
GROQ_MODEL=llama-3.3-70b-versatile

# Path to the DuckDB database (relative to project root)
DB_PATH=data/chinook.duckdb

# Max number of tables the schema retriever returns per query
TOP_K_TABLES=5
